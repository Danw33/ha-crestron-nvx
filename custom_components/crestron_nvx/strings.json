{
  "title": "Crestron DM NVX",
  "config": {
    "step": {
      "user": {
        "title": "Connect to a DM NVX endpoint",
        "description": "Enter the local endpoint credentials. This integration currently performs read-only requests.",
        "data": {
          "host": "Host name or IP address",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify TLS certificate"
        },
        "data_description": {
          "verify_ssl": "Certificate verification is disabled by default because DM NVX endpoints commonly use self-signed certificates. When disabled, Home Assistant cannot verify the endpoint's identity; use this only on a trusted local network. Enable verification when Home Assistant trusts the endpoint certificate."
        }
      },
      "reauth_confirm": {
        "title": "Update DM NVX credentials",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Reconfigure DM NVX endpoint",
        "data": {
          "host": "Host name or IP address",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify TLS certificate"
        },
        "data_description": {
          "verify_ssl": "Certificate verification is disabled by default because DM NVX endpoints commonly use self-signed certificates. When disabled, Home Assistant cannot verify the endpoint's identity; use this only on a trusted local network. Enable verification when Home Assistant trusts the endpoint certificate."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid authentication",
      "invalid_host": "Enter a valid host name or IP address",
